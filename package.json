{
  "name": "service-day",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "seed": "node mock-api/seed.mjs",
    "api": "json-server mock-api/db.json --port 3000",
    "dev": "node mock-api/seed.mjs --if-missing && concurrently --names api,web --prefix-colors yellow,cyan --kill-others \"npm:api\" \"npm:start\"",
    "db:reset": "node mock-api/seed.mjs",
    "api:lan": "json-server mock-api/db.json --port 3000 --host 0.0.0.0",
    "start:lan": "ng serve --configuration lan --host 0.0.0.0",
    "dev:lan": "node mock-api/seed.mjs --if-missing && concurrently --names api,web --prefix-colors yellow,cyan --kill-others \"npm:api:lan\" \"npm:start:lan\""
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lucide/angular": "^1.70.0",
    "angularx-qrcode": "^22.0.1",
    "chart.js": "^4.6.1",
    "date-fns": "^4.4.0",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "json-server": "^1.0.0-beta.15",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
